# Docker deployment: the domain pointing at this server
DOMAIN=files.example.com
SITE_NAME=SealDrop
MAX_UPLOAD_GB=50

# Ports on this server that Caddy listens on. Automatic HTTPS certificates need
# 80 and 443 reachable from the internet, so only change these if you forward
# 80/443 to them (e.g. from a router), or the certificate can't be issued.
HTTP_PORT=80
HTTPS_PORT=443
# Port the app listens on inside Docker (Caddy forwards to it). Must be 1024 or higher.
APP_PORT=18446
# If HTTPS_PORT isn't reachable as 443 from outside, set the full public address:
# PUBLIC_URL=https://files.example.com:8443

# Running without Docker, on your own machine:
# PORT=8080
# PUBLIC_URL=http://127.0.0.1:8080
# DATA_DIR=./data
