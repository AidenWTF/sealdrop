# Copy to .env and fill in the section for how you deploy.

# --- App settings (used by every setup) -------------------------------------
SITE_NAME=SealDrop
MAX_UPLOAD_GB=50
# Port the app listens on inside Docker. Caddy or your own proxy connects to it;
# it is never opened on the server itself. Must be 1024 or higher.
APP_PORT=18446
# The address people use to reach the site.
#  - docker-compose.no-caddy.yml: required, e.g. https://files.example.com
#  - docker-compose.yml: optional, defaults to https://CADDY_DOMAIN. Set it only
#    if CADDY_HTTPS_PORT isn't reachable as 443, e.g. https://files.example.com:8443
# PUBLIC_URL=https://files.example.com

# --- Bundled Caddy (docker-compose.yml only) --------------------------------
# Ignored by docker-compose.no-caddy.yml (Coolify or another proxy).
# The domain pointing at this server. Caddy gets its HTTPS certificate for it.
CADDY_DOMAIN=files.example.com
# Ports Caddy opens on this server. Automatic certificates need 80 and 443
# reachable from the internet, so only change these if you forward 80/443 to them.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Running without Docker (npm start) -------------------------------------
# PORT=8080
# PUBLIC_URL=http://127.0.0.1:8080
# DATA_DIR=./data
