# Copy to .env and fill in.

# The address people use to reach the site, as served by your proxy (e.g. Coolify).
PUBLIC_URL=https://files.example.com
# Port the app listens on inside Docker; point your proxy at it.
# It is never opened on the server itself. Must be 1024 or higher.
APP_PORT=18446
SITE_NAME=SealDrop
MAX_UPLOAD_GB=50
# Videos over DISCORD_COPY_OVER_MB get a smaller copy (H.264, up to 1080p, under 45 MB)
# used only for Discord embeds, since Discord won't embed large videos. The share page
# and downloads keep the original. Set DISCORD_COPIES=0 to turn this off.
DISCORD_COPIES=1
DISCORD_COPY_OVER_MB=45

# Optional: let everyone at your OIDC provider (such as Pocket ID) sign in, each with their
# own private list of files. In Pocket ID, add an OIDC client with the callback URL
#   <PUBLIC_URL>/oidc/callback
# and copy its client ID and secret here. Leave OIDC_ISSUER empty to keep this off.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Pocket ID
# Only let members of this group in (optional; Pocket ID can also limit this per client).
# OIDC_ALLOWED_GROUP=
# Unlocks every member's file list. Make it once with: openssl rand -base64 32
# Keep it in your platform's settings, not on the data disk, and never change it:
# a new value means members lose their lists (their links keep working).
# MEMBER_KEY=


# --- ONLY for docker-compose.caddy.yml (bundled Caddy, no proxy of your own) ---
# docker-compose.yml ignores everything in this section. To use Caddy, uncomment
# these and set PUBLIC_URL above to https://<CADDY_DOMAIN>.
#
# The domain pointing at this server. Caddy gets its HTTPS certificate for it.
# CADDY_DOMAIN=files.example.com
# Ports Caddy opens on this server. Automatic certificates need 80 and 443
# reachable from the internet, so only change these if you forward 80/443 to them.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443


# --- ONLY for running without Docker (npm start) ---
# PORT=8080
# PUBLIC_URL=http://127.0.0.1:8080
# DATA_DIR=./data
