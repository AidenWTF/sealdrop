# Copy to .env and fill in.

# The address people use to reach the site, as served by your proxy (e.g. Coolify).
PUBLIC_URL=https://files.example.com
# Port the app listens on inside Docker; point your proxy at it.
# It is never opened on the server itself. Must be 1024 or higher.
APP_PORT=18446
SITE_NAME=SealDrop
MAX_UPLOAD_GB=50


# --- ONLY for docker-compose.caddy.yml (bundled Caddy, no proxy of your own) ---
# docker-compose.yml ignores everything in this section. To use Caddy, uncomment
# these and set PUBLIC_URL above to https://<CADDY_DOMAIN>.
#
# The domain pointing at this server. Caddy gets its HTTPS certificate for it.
# CADDY_DOMAIN=files.example.com
# Ports Caddy opens on this server. Automatic certificates need 80 and 443
# reachable from the internet, so only change these if you forward 80/443 to them.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443


# --- ONLY for running without Docker (npm start) ---
# PORT=8080
# PUBLIC_URL=http://127.0.0.1:8080
# DATA_DIR=./data
